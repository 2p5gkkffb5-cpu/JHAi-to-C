APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
DEMO_MODE=false

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
LANGGRAPH_CHECKPOINT_PATH=./data/checkpoints.db
CORS_ORIGINS=http://localhost:5174
AUTH_ENABLED=false
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
VITE_AUTH_ENABLED=false
ASSET_UPLOAD_DIR=./data/uploads
ASSET_MAX_BYTES=10485760
ASSET_VIDEO_MAX_BYTES=104857600
# Production must expose this URL to external image/video providers.
ASSET_PUBLIC_BASE_URL=
WEB_HOST=127.0.0.1
WEB_PORT=5174

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-3.1-pro
LLM_API_BASE_URL=https://grsai.dakka.com.cn/v1
VIDEO_UNDERSTANDING_NATIVE_ENABLED=true
VIDEO_UNDERSTANDING_NATIVE_MAX_BYTES=20971520
VIDEO_UNDERSTANDING_NATIVE_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5

RESEARCH_PROVIDER=mock
RESEARCH_API_KEY=
RESEARCH_API_BASE_URL=https://api.bocha.cn/v1
RESEARCH_REQUEST_TIMEOUT_SECONDS=30
RESEARCH_MAX_RESULTS=8
RESEARCH_MAX_RETRIES=2
RESEARCH_RETRY_BASE_DELAY_SECONDS=0.5

IMAGE_PROVIDER=disabled
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2-vip
IMAGE_API_BASE_URL=https://grsai.dakka.com.cn/v1
IMAGE_REQUEST_TIMEOUT_SECONDS=180

VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_REQUEST_TIMEOUT_SECONDS=30
VIDEO_POLL_INTERVAL_SECONDS=15
VIDEO_TASK_TIMEOUT_SECONDS=900

# Optional YG Seedance-compatible gateway. When either YG field is set and
# VIDEO_PROVIDER=real, both BASE_URL and API_KEY are required.
YG_SEEDANCE_BASE_URL=
YG_SEEDANCE_API_KEY=
YG_SEEDANCE_MODEL=doubao-seedance-2.0
YG_SEEDANCE_VIDEO_GENERATION_PATH=/api/v3/contents/generations/tasks?beta=true
YG_SEEDANCE_VIDEO_STATUS_PATH_TEMPLATE=/api/v3/contents/generations/tasks/{task_id}?beta=true

MOCK_PROVIDER_LATENCY_MS=250
MOCK_PROVIDER_SCENARIO=success
